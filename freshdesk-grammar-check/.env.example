# ---- Freshdesk ----
# Your Freshdesk subdomain: for https://acme.freshdesk.com use "acme".
FRESHDESK_DOMAIN=your-subdomain
# Freshdesk API key (Profile Settings -> "Your API Key"). Secret — never commit.
FRESHDESK_API_KEY=

# Optional: only check replies on tickets in this Freshdesk group (your team).
# Leave blank to check every group. Find the ID in Admin -> Groups (URL contains it).
FRESHDESK_GROUP_ID=
# Optional: comma-separated Freshdesk agent IDs to restrict to specific agents.
# Leave blank to check all agents (subject to FRESHDESK_GROUP_ID if set).
FRESHDESK_AGENT_IDS=

# ---- Anthropic (grammar judgment) ----
ANTHROPIC_API_KEY=
# Model used for the grammar check. Haiku is cheap and fast; good enough here.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---- Slack (alerts) ----
# Bot token (xoxb-...) with chat:write. Used to DM you or post to a channel.
SLACK_BOT_TOKEN=
# Where alerts go: a channel ID (C…), or your Slack user ID (U…) to get a DM.
SLACK_TARGET=

# ---- Behavior ----
# errors      = only real spelling/grammar mistakes (recommended to start)
# clarity     = errors + awkward/unclear phrasing and off-tone wording
# all         = grammar, clarity, tone, formatting, capitalization
STRICTNESS=errors
# How far back to look on the very first run (no state yet), in hours.
LOOKBACK_HOURS=24
# Max tickets to scan per run (safety cap on API usage).
MAX_TICKETS=200
